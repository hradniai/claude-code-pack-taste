  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-safety-extended.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-safety-extended.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/inject-current-time.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "_comment_telemetry": "DISABLE_TELEMETRY is a deliberate privacy choice, and it costs features: it also stops Claude Code from fetching feature flags, so Remote Control, native reading of AGENTS.md (the pack ships a CLAUDE.md beside every AGENTS.md for this reason), syncing skills and plugins enabled on claude.ai, /skill-doctor and the advisor tool are unavailable. Any non-empty value, even 0 or false, keeps telemetry off; delete the line to turn it back on.",
  "_comment_teams": "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS in env above unlocks the 'teammates' multi-agent feature (off by default in Claude Code). It is not free: while it is on, any subagent Claude gives a name launches as a teammate, so teams can form during ordinary delegation nobody framed as team work, and every teammate is a separate session with its own context window, which uses significantly more of the plan's usage. Delete the line to make named subagents plain subagents again.",
  "_comment_trust": "The 'Do you trust the files in this folder?' dialog CANNOT be turned off here - no settings.json key or safe env var exists for it, and bypass mode (which would skip it) is deliberately locked off. To pre-trust your working directories without weakening the safety baseline, run scripts/trust-workspace.sh (it merges per-directory trust flags into ~/.claude.json). See INSTRUCTIONS.md.",
  "feedbackSurveyRate": 0,
  "_comment_cleanup": "cleanupPeriodDays controls how long Claude Code keeps local conversation transcripts before deleting them. 3650 = 10 years of retention. The minimum is 1: Claude Code rejects 0 as invalid, and a value that fails validation voids this whole file, deny rules included, so there is no 'never delete' value, only a very large one.",
  "cleanupPeriodDays": 3650
}
