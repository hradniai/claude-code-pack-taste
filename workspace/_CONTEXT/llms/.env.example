# Copy this file next to it under the name .env and paste your own access keys in.
# An access key is the long code you identify yourself with at a model provider.
# Claude never reads these values: the evaluation loads them inside its own process,
# and no key appears in a report, in a log, or in the chat. Never commit the copy.
# Fill in only the providers you actually use. Google accepts either of its two names.
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
